---
import { Check, Minus, Activity, Gauge, FlaskConical, ShieldCheck } from '@lucide/astro';
import { consolePreview as cp, type Tone } from '../data/console-preview';
import { site } from '../data/site.config';
import { withPeriod } from '../lib/text';

// One accent: teal for the console's own state, status colours for outcomes, no violet here.
const toneText: Record<Tone, string> = {
  cyan: 'text-accent',
  emerald: 'text-ok',
  amber: 'text-warn',
  violet: 'text-accent',
  rose: 'text-err',
  slate: 'text-muted',
};
const nodePill = {
  completed: 'pill-ok',
  retrying: 'pill-warn',
  waiting: 'pill-accent',
  pending: 'pill-neutral',
} as const;
const nodeDot = {
  completed: 'border-ok bg-ok',
  retrying: 'border-warn bg-warn',
  waiting: 'border-accent bg-surface',
  pending: 'border-line-strong bg-surface',
} as const;

// Throughput chart as an SVG path, 0..100 values over a 240 x 64 box.
const w = 240;
const h = 64;
const step = w / (cp.series.length - 1);
const points = cp.series.map((v, i) => `${(i * step).toFixed(1)},${(h - (v / 100) * h).toFixed(1)}`);
const line = `M${points.join(' L')}`;
const area = `${line} L${w},${h} L0,${h} Z`;
const heading = withPeriod(cp.heading);
const selfHosted = site.trust[0];
const consoleName = site.products.find((p) => p.id === 'console')?.name;
---

<section id="console" class="scroll-mt-20 border-y border-line bg-surface-2 py-20" aria-labelledby="console-title">
  <div class="container-x">
    <p class="eyebrow">{cp.eyebrow}</p>
    <h2 id="console-title" class="mt-3 max-w-3xl text-3xl font-semibold tracking-tight text-balance">
      {heading.text}<span class="text-accent">{heading.period}</span>
    </h2>
    <p class="mt-4 max-w-2xl text-muted">{cp.intro}</p>

    <div data-tabs class="mt-10">
      <div role="tablist" aria-label="Console views" class="flex gap-2 overflow-x-auto pb-1">
        {
          cp.tabs.map((tab, i) => (
            <button
              type="button"
              role="tab"
              id={`console-tab-${tab.id}`}
              aria-controls={`console-panel-${tab.id}`}
              aria-selected={i === 0 ? 'true' : 'false'}
              tabindex={i === 0 ? 0 : -1}
              class="shrink-0 whitespace-nowrap rounded-[0.4rem] border border-line bg-surface px-3.5 py-2 text-sm text-muted hover:text-ink"
            >
              {tab.label}
            </button>
          ))
        }
      </div>

      {
        cp.tabs.map((tab, i) => (
          <div
            role="tabpanel"
            id={`console-panel-${tab.id}`}
            aria-labelledby={`console-tab-${tab.id}`}
            hidden={i !== 0}
            class="mt-6 grid gap-8 lg:grid-cols-[minmax(0,19rem)_minmax(0,1fr)]"
          >
            <div class="min-w-0">
              <h3 class="text-xl font-semibold">{tab.title}</h3>
              <p class="mt-3 text-sm leading-relaxed text-muted">{tab.description}</p>
              <ul class="mt-5 space-y-2 text-sm">
                {tab.bullets.map((b) => (
                  <li class="flex gap-2">
                    <Check size={16} class="mt-0.5 shrink-0 text-accent" aria-hidden="true" />
                    {b}
                  </li>
                ))}
              </ul>
            </div>

            <figure class="panel min-w-0 overflow-hidden" aria-label={`${tab.label} mock-up`}>
              <div class="flex items-center justify-center gap-2 border-b border-line bg-surface-2 px-3 py-1.5 text-[0.7rem] text-warn">
                <FlaskConical size={12} class="shrink-0" aria-hidden="true" />
                <span class="font-semibold uppercase tracking-wider">{cp.sampleNote}</span>
              </div>
              <div class="flex min-w-0">
                <div class="hidden w-44 shrink-0 flex-col border-r border-line bg-surface-2 p-3 md:flex" aria-hidden="true">
                  <div class="flex items-center gap-2 text-sm font-semibold">
                    <span class="kpi-icon text-accent"><Activity size={14} /></span>
                    {consoleName}
                  </div>
                  <ul class="mt-5 space-y-1 text-xs">
                    {cp.tabs.map((t, n) => (
                      <li
                        class:list={[
                          'flex items-center justify-between rounded-[0.4rem] border px-2 py-1.5',
                          t.id === tab.id ? 'border-accent/30 bg-accent-tint text-accent' : 'border-transparent text-muted',
                        ]}
                      >
                        <span class="truncate">{t.label}</span>
                        <span class="font-mono text-[0.6rem] text-faint">0{n + 1}</span>
                      </li>
                    ))}
                  </ul>
                  <div class="mt-auto rounded-[0.4rem] border border-line bg-surface p-2.5 text-[0.68rem] leading-snug">
                    <div class="flex items-center gap-1.5 font-semibold text-ink">
                      <ShieldCheck size={12} class="text-accent" />
                      {selfHosted.label}
                    </div>
                    <p class="mt-1 text-muted">{selfHosted.detail}</p>
                  </div>
                </div>

                <div class="min-w-0 flex-1">
                  <div class="flex items-center gap-3 border-b border-line px-4 py-2.5">
                    <span class="min-w-0 flex-1 truncate font-mono text-[0.7rem] text-faint">
                      {cp.labels.host}<span class="text-ink">{tab.route}</span>
                    </span>
                  </div>

                  <div class="p-4 sm:p-5">
                    {tab.id === 'kpis' && (
                      <div>
                        <div class="flex items-center gap-2 text-[0.7rem] text-ok">
                          <span class="size-1.5 rounded-full bg-ok" /> <span class="font-mono">{cp.labels.live}</span>
                        </div>
                        <div class="mt-3 grid grid-cols-2 gap-3 xl:grid-cols-4">
                          {cp.kpis.map((kpi, n) => (
                            <div class="kpi">
                              <div class="flex items-start justify-between gap-2">
                                <span class="text-xs text-muted">{kpi.label}</span>
                                <span class={`kpi-icon ${toneText[kpi.tone]}`} aria-hidden="true">
                                  {n === 0 ? <Activity size={14} /> : <Gauge size={14} />}
                                </span>
                              </div>
                              <div class="mt-2 flex items-baseline gap-1">
                                <span class="font-mono text-2xl font-semibold tracking-tight text-ink">{kpi.value}</span>
                                <span class="text-xs text-faint">{kpi.unit}</span>
                              </div>
                              {kpi.delta && <div class="mt-1 font-mono text-[0.68rem] text-ok">{kpi.delta}</div>}
                            </div>
                          ))}
                        </div>
                        <div class="kpi mt-3">
                          <div class="flex justify-between text-[0.7rem]">
                            <span class="text-muted">{cp.labels.sparkline}</span>
                            <span class="font-mono text-faint">jobs/s</span>
                          </div>
                          <svg
                            viewBox={`0 0 ${w} ${h}`}
                            class="mt-3 h-24 w-full border-y border-line text-accent"
                            preserveAspectRatio="none"
                            aria-hidden="true"
                          >
                            {[16, 32, 48].map((y) => (
                              <line x1="0" x2={w} y1={y} y2={y} stroke="var(--line)" stroke-width="1" vector-effect="non-scaling-stroke" />
                            ))}
                            <path d={area} fill="currentColor" fill-opacity="0.1" />
                            <path d={line} fill="none" stroke="currentColor" stroke-width="1.5" vector-effect="non-scaling-stroke" />
                          </svg>
                        </div>
                        <div class="mt-3 overflow-x-auto">
                          <table class="table-hairline text-xs">
                            <thead>
                              <tr>
                                <th>queue</th>
                                <th class="text-right">depth</th>
                                <th class="text-right">workers</th>
                                <th class="text-right">state</th>
                              </tr>
                            </thead>
                            <tbody>
                              {cp.queues.map((q) => (
                                <tr>
                                  <td class="py-2 font-medium text-ink">{q.name}</td>
                                  <td class="py-2 text-right font-mono text-muted">{q.depth}</td>
                                  <td class="py-2 text-right font-mono text-muted">{q.workers}</td>
                                  <td class="py-2 text-right">
                                    <span class={`pill pill-dot ${q.state === 'paused' ? 'pill-warn' : 'pill-ok'}`}>{q.state}</span>
                                  </td>
                                </tr>
                              ))}
                            </tbody>
                          </table>
                        </div>
                      </div>
                    )}

                    {tab.id === 'workflow' && (
                      <div class="grid gap-5 xl:grid-cols-[minmax(0,1fr)_minmax(0,1.2fr)]">
                        <div class="min-w-0">
                          <div class="flex flex-wrap items-center gap-2 font-mono text-[0.7rem] text-faint">
                            {cp.workflow.name} · <span class="text-ink">{cp.workflow.runId}</span>
                            <span class="pill pill-accent pill-dot font-sans">{cp.workflow.status}</span>
                          </div>
                          <ol class="mt-3">
                            {cp.workflow.nodes.map((node, n) => (
                              <li class="relative pb-2.5 pl-6 last:pb-0">
                                {n < cp.workflow.nodes.length - 1 && (
                                  <span class="absolute left-[0.4rem] top-4 h-full w-px bg-line-strong" aria-hidden="true" />
                                )}
                                <span
                                  class={`absolute left-0 top-2 size-3.5 rounded-full border-2 ${nodeDot[node.status]}`}
                                  aria-hidden="true"
                                />
                                <div class="rounded-[0.4rem] border border-line bg-surface px-2.5 py-1.5 font-mono text-[0.72rem]">
                                  <div class="flex items-center justify-between gap-2">
                                    <span class="truncate text-ink">{node.id}</span>
                                    <span class={`pill font-sans ${nodePill[node.status]}`}>{node.status}</span>
                                  </div>
                                  {node.note && <div class="mt-0.5 text-faint">{node.kind} · {node.note}</div>}
                                </div>
                              </li>
                            ))}
                          </ol>
                        </div>
                        <div class="min-w-0">
                          <div class="flex items-center justify-between text-[0.7rem]">
                            <span class="label">{cp.labels.history}</span>
                            <span class="font-mono text-faint">seq {cp.workflow.history.at(-1)?.seq} / {cp.workflow.history.at(-1)?.seq}</span>
                          </div>
                          <input
                            type="range"
                            min="1"
                            max="10"
                            value="10"
                            disabled
                            aria-label={cp.labels.scrubber}
                            class="mt-2 w-full accent-accent"
                          />
                          <ol class="mt-2 divide-y divide-line rounded-[0.4rem] border border-line">
                            {cp.workflow.history.map((row) => (
                              <li class="grid grid-cols-[2rem_minmax(0,1fr)] gap-2 px-2.5 py-1.5 font-mono text-[0.7rem]">
                                <span class="text-faint">#{row.seq}</span>
                                <span class="min-w-0">
                                  <span class={toneText[row.tone]}>{row.type}</span>
                                  {row.step && <span class="text-muted"> · {row.step}</span>}
                                  <span class="block truncate text-faint">{row.detail}</span>
                                </span>
                              </li>
                            ))}
                          </ol>
                        </div>
                      </div>
                    )}

                    {tab.id === 'dlq' && (
                      <div>
                        <div class="flex flex-wrap items-center justify-between gap-3 rounded-[0.4rem] border border-accent/30 bg-accent-tint px-3 py-2">
                          <span class="font-mono text-xs text-accent">{cp.deadLetters.length} {cp.labels.selected}</span>
                          <span class="flex flex-wrap gap-2">
                            <span class="rounded-[0.4rem] border border-line-strong bg-surface px-2.5 py-1 text-xs text-ink">{cp.labels.actions[0]}</span>
                            <span class="rounded-[0.4rem] border border-err/40 bg-surface px-2.5 py-1 text-xs text-err">{cp.labels.actions[1]}</span>
                            <span class="rounded-[0.4rem] bg-accent px-2.5 py-1 text-xs font-semibold text-accent-ink">{cp.labels.actions[2]}</span>
                          </span>
                        </div>
                        <div class="mt-3 overflow-x-auto">
                          <table class="table-hairline min-w-[30rem] text-xs">
                            <thead>
                              <tr>
                                <th class="w-6" />
                                <th>jid</th>
                                <th>job</th>
                                <th>queue</th>
                                <th>error</th>
                              </tr>
                            </thead>
                            <tbody>
                              {cp.deadLetters.map((d) => (
                                <tr>
                                  <td class="py-2">
                                    <span class="grid size-3.5 place-items-center rounded-sm bg-accent text-accent-ink">
                                      <Check size={10} stroke-width={3} aria-hidden="true" />
                                    </span>
                                  </td>
                                  <td class="py-2 font-mono text-muted">{d.jid}</td>
                                  <td class="py-2 font-medium text-ink">{d.job}</td>
                                  <td class="py-2 text-muted">{d.queue}</td>
                                  <td class="py-2">
                                    <span class={`pill pill-dot ${d.error === 'decryption_error' ? 'pill-warn' : 'pill-err'}`}>{d.error}</span>
                                  </td>
                                </tr>
                              ))}
                            </tbody>
                          </table>
                        </div>
                        <div class="mt-4 flex flex-wrap items-center gap-2 text-[0.7rem]">
                          <span class="font-mono text-faint">{cp.labels.redriveCall}</span>
                          <span class="pill pill-ok pill-dot">succeeded {cp.bulkResult.succeeded}</span>
                          <span class="pill pill-neutral">missing {cp.bulkResult.missing}</span>
                          <span class="pill pill-warn pill-dot">unredrivable {cp.bulkResult.unredrivable}</span>
                          <span class="pill pill-neutral">conflicted {cp.bulkResult.conflicted}</span>
                        </div>
                      </div>
                    )}

                    {tab.id === 'access' && (
                      <div class="grid gap-5 xl:grid-cols-[minmax(0,1.3fr)_minmax(0,1fr)]">
                        <div class="min-w-0 overflow-x-auto">
                          <table class="table-hairline min-w-[22rem] text-xs">
                            <thead>
                              <tr>
                                <th>capability</th>
                                <th class="text-center">viewer</th>
                                <th class="text-center">operator</th>
                                <th class="text-center">admin</th>
                              </tr>
                            </thead>
                            <tbody>
                              {cp.roles.map((r) => (
                                <tr>
                                  <td class="py-2 pr-2 text-muted">{r.capability}</td>
                                  {[r.viewer, r.operator, r.admin].map((on) => (
                                    <td class="py-2 text-center">
                                      {on ? (
                                        <Check size={14} class="inline text-ok" aria-label="yes" />
                                      ) : (
                                        <Minus size={14} class="inline text-faint" aria-label="no" />
                                      )}
                                    </td>
                                  ))}
                                </tr>
                              ))}
                            </tbody>
                          </table>
                        </div>
                        <div class="min-w-0 space-y-4">
                          <div class="divide-y divide-line rounded-[0.4rem] border border-line">
                            {cp.security.map((s) => (
                              <div class="flex items-center justify-between gap-2 px-2.5 py-1.5 text-xs">
                                <span class="text-muted">{s.label}</span>
                                <span class="truncate font-mono text-ink">{s.value}</span>
                              </div>
                            ))}
                          </div>
                          <div>
                            <div class="label">{cp.labels.audit}</div>
                            <ul class="mt-1.5 divide-y divide-line rounded-[0.4rem] border border-line">
                              {cp.audit.map((a) => (
                                <li class="flex items-center justify-between gap-2 px-2.5 py-1.5 font-mono text-[0.68rem]">
                                  <span class="truncate text-accent">{a.action}</span>
                                  <span class="truncate text-muted">{a.actor}</span>
                                </li>
                              ))}
                            </ul>
                          </div>
                        </div>
                      </div>
                    )}
                  </div>
                </div>
              </div>
            </figure>
          </div>
        ))
      }
    </div>
  </div>
</section>

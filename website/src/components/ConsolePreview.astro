---
import { Check, Minus } from '@lucide/astro';
import { consolePreview as cp, type Tone } from '../data/console-preview';

const toneText: Record<Tone, string> = {
  cyan: 'text-oss',
  emerald: 'text-healthy',
  amber: 'text-warn',
  violet: 'text-pro',
  rose: 'text-danger',
  slate: 'text-muted',
};
const nodeStyle = {
  completed: 'border-healthy/40 bg-healthy/10 text-healthy',
  retrying: 'border-warn/40 bg-warn/10 text-warn',
  waiting: 'border-pro/50 bg-pro/10 text-pro',
  pending: 'border-line-strong bg-white/[0.02] text-faint',
} as const;

// Throughput sparkline as an SVG path, 0..100 values over a 240 x 64 box.
const w = 240;
const h = 64;
const step = w / (cp.series.length - 1);
const points = cp.series.map((v, i) => `${(i * step).toFixed(1)},${(h - (v / 100) * h).toFixed(1)}`);
const line = `M${points.join(' L')}`;
const area = `${line} L${w},${h} L0,${h} Z`;
---

<section id="console" class="scroll-mt-20 border-y border-line bg-surface-2/60 py-20" aria-labelledby="console-title">
  <div class="container-x">
    <p class="eyebrow !text-healthy">{cp.eyebrow}</p>
    <h2 id="console-title" class="mt-3 max-w-3xl text-3xl font-semibold tracking-tight text-balance">{cp.heading}</h2>
    <p class="mt-4 max-w-2xl text-muted">{cp.intro}</p>

    <div data-tabs class="mt-10">
      <div role="tablist" aria-label="Console views" class="flex gap-2 overflow-x-auto pb-1">
        {
          cp.tabs.map((tab, i) => (
            <button
              type="button"
              role="tab"
              id={`console-tab-${tab.id}`}
              aria-controls={`console-panel-${tab.id}`}
              aria-selected={i === 0 ? 'true' : 'false'}
              tabindex={i === 0 ? 0 : -1}
              class="shrink-0 whitespace-nowrap rounded-lg border border-line px-3.5 py-2 text-sm text-muted hover:text-ink"
            >
              {tab.label}
            </button>
          ))
        }
      </div>

      {
        cp.tabs.map((tab, i) => (
          <div
            role="tabpanel"
            id={`console-panel-${tab.id}`}
            aria-labelledby={`console-tab-${tab.id}`}
            hidden={i !== 0}
            class="mt-6 grid gap-8 lg:grid-cols-[minmax(0,20rem)_minmax(0,1fr)]"
          >
            <div class="min-w-0">
              <h3 class="text-xl font-semibold">{tab.title}</h3>
              <p class="mt-3 text-sm leading-relaxed text-muted">{tab.description}</p>
              <ul class="mt-5 space-y-2 text-sm">
                {tab.bullets.map((b) => (
                  <li class="flex gap-2">
                    <Check size={16} class="mt-0.5 shrink-0 text-healthy" aria-hidden="true" />
                    {b}
                  </li>
                ))}
              </ul>
            </div>

            <figure class="panel min-w-0 overflow-hidden" aria-label={`${tab.label} mock-up`}>
              <div class="flex items-center gap-3 border-b border-line bg-bg/60 px-3 py-2">
                <span class="flex gap-1.5" aria-hidden="true">
                  <span class="size-2.5 rounded-full bg-white/15" />
                  <span class="size-2.5 rounded-full bg-white/15" />
                  <span class="size-2.5 rounded-full bg-white/15" />
                </span>
                <span class="min-w-0 flex-1 truncate rounded bg-white/5 px-2 py-0.5 font-mono text-[0.7rem] text-faint">
                  {cp.labels.host}{tab.route}
                </span>
                <span class="hidden font-mono text-[0.65rem] uppercase tracking-wider text-faint sm:inline">{cp.sampleNote}</span>
              </div>

              <div class="p-4 sm:p-5">
                {tab.id === 'kpis' && (
                  <div>
                    <div class="flex items-center gap-2 font-mono text-[0.7rem] text-healthy">
                      <span class="size-1.5 animate-pulse rounded-full bg-healthy" /> {cp.labels.live}
                    </div>
                    <div class="mt-3 grid grid-cols-2 gap-3 sm:grid-cols-4">
                      {cp.kpis.map((kpi) => (
                        <div class="rounded-lg border border-line bg-bg/50 p-3">
                          <div class="font-mono text-[0.68rem] uppercase tracking-wider text-faint">{kpi.label}</div>
                          <div class="mt-1 flex items-baseline gap-1">
                            <span class={`font-mono text-xl font-semibold ${toneText[kpi.tone]}`}>{kpi.value}</span>
                            <span class="text-xs text-faint">{kpi.unit}</span>
                          </div>
                          {kpi.delta && <div class="mt-0.5 font-mono text-[0.68rem] text-healthy">{kpi.delta}</div>}
                        </div>
                      ))}
                    </div>
                    <div class="mt-4 rounded-lg border border-line bg-bg/50 p-3">
                      <div class="flex justify-between font-mono text-[0.68rem] text-faint">
                        <span>{cp.labels.sparkline}</span>
                        <span>jobs/s</span>
                      </div>
                      <svg viewBox={`0 0 ${w} ${h}`} class="mt-2 h-20 w-full" preserveAspectRatio="none" aria-hidden="true">
                        <defs>
                          <linearGradient id="spark" x1="0" x2="0" y1="0" y2="1">
                            <stop offset="0%" stop-color="#38BDF8" stop-opacity="0.35" />
                            <stop offset="100%" stop-color="#38BDF8" stop-opacity="0" />
                          </linearGradient>
                        </defs>
                        <path d={area} fill="url(#spark)" />
                        <path d={line} fill="none" stroke="#38BDF8" stroke-width="1.5" vector-effect="non-scaling-stroke" />
                      </svg>
                    </div>
                    <table class="mt-4 w-full text-left font-mono text-xs">
                      <thead class="text-faint">
                        <tr>
                          <th class="py-1.5 font-normal">queue</th>
                          <th class="py-1.5 font-normal">depth</th>
                          <th class="py-1.5 font-normal">workers</th>
                          <th class="py-1.5 text-right font-normal">state</th>
                        </tr>
                      </thead>
                      <tbody>
                        {cp.queues.map((q) => (
                          <tr class="border-t border-line">
                            <td class="py-2 text-ink">{q.name}</td>
                            <td class="py-2 text-muted">{q.depth}</td>
                            <td class="py-2 text-muted">{q.workers}</td>
                            <td class={`py-2 text-right ${q.state === 'paused' ? 'text-warn' : 'text-healthy'}`}>{q.state}</td>
                          </tr>
                        ))}
                      </tbody>
                    </table>
                  </div>
                )}

                {tab.id === 'workflow' && (
                  <div class="grid gap-5 md:grid-cols-[minmax(0,1fr)_minmax(0,1.25fr)]">
                    <div class="min-w-0">
                      <div class="font-mono text-[0.7rem] text-faint">
                        {cp.workflow.name} · <span class="text-ink">{cp.workflow.runId}</span> ·{' '}
                        <span class="text-oss">{cp.workflow.status}</span>
                      </div>
                      <ol class="mt-3">
                        {cp.workflow.nodes.map((node, n) => (
                          <li class="relative pb-3 pl-6 last:pb-0">
                            {n < cp.workflow.nodes.length - 1 && (
                              <span class="absolute left-[0.4rem] top-4 h-full w-px bg-line-strong" aria-hidden="true" />
                            )}
                            <span
                              class={`absolute left-0 top-1.5 size-3.5 rounded-full border-2 ${nodeStyle[node.status]}`}
                              aria-hidden="true"
                            />
                            <div class={`rounded-md border px-2.5 py-1.5 font-mono text-[0.72rem] ${nodeStyle[node.status]}`}>
                              <div class="flex items-center justify-between gap-2">
                                <span class="truncate text-ink">{node.id}</span>
                                <span class="shrink-0 opacity-90">{node.status}</span>
                              </div>
                              {node.note && <div class="mt-0.5 text-faint">{node.kind} · {node.note}</div>}
                            </div>
                          </li>
                        ))}
                      </ol>
                    </div>
                    <div class="min-w-0">
                      <div class="flex items-center justify-between font-mono text-[0.7rem] text-faint">
                        <span>{cp.labels.history}</span>
                        <span>seq {cp.workflow.history.at(-1)?.seq} / {cp.workflow.history.at(-1)?.seq}</span>
                      </div>
                      <input
                        type="range"
                        min="1"
                        max="10"
                        value="10"
                        disabled
                        aria-label={cp.labels.scrubber}
                        class="mt-2 w-full accent-[#38BDF8]"
                      />
                      <ol class="mt-2 space-y-1">
                        {cp.workflow.history.map((row) => (
                          <li class="grid grid-cols-[2rem_minmax(0,1fr)] gap-2 rounded border border-line bg-bg/50 px-2 py-1.5 font-mono text-[0.7rem]">
                            <span class="text-faint">#{row.seq}</span>
                            <span class="min-w-0">
                              <span class={toneText[row.tone]}>{row.type}</span>
                              {row.step && <span class="text-muted"> · {row.step}</span>}
                              <span class="block truncate text-faint">{row.detail}</span>
                            </span>
                          </li>
                        ))}
                      </ol>
                    </div>
                  </div>
                )}

                {tab.id === 'dlq' && (
                  <div>
                    <div class="flex flex-wrap items-center justify-between gap-3 rounded-lg border border-oss/30 bg-oss/5 px-3 py-2">
                      <span class="font-mono text-xs text-oss">{cp.deadLetters.length} {cp.labels.selected}</span>
                      <span class="flex gap-2">
                        <span class="rounded-md border border-line-strong px-2.5 py-1 text-xs text-muted">{cp.labels.actions[0]}</span>
                        <span class="rounded-md border border-danger/40 px-2.5 py-1 text-xs text-danger">{cp.labels.actions[1]}</span>
                        <span class="rounded-md bg-oss px-2.5 py-1 text-xs font-semibold text-[#04121d]">{cp.labels.actions[2]}</span>
                      </span>
                    </div>
                    <div class="mt-3 overflow-x-auto">
                      <table class="w-full min-w-[30rem] text-left font-mono text-xs">
                        <thead class="text-faint">
                          <tr>
                            <th class="w-6 py-1.5 font-normal" />
                            <th class="py-1.5 font-normal">jid</th>
                            <th class="py-1.5 font-normal">job</th>
                            <th class="py-1.5 font-normal">queue</th>
                            <th class="py-1.5 font-normal">error</th>
                          </tr>
                        </thead>
                        <tbody>
                          {cp.deadLetters.map((d) => (
                            <tr class="border-t border-line">
                              <td class="py-2">
                                <span class="grid size-3.5 place-items-center rounded-sm bg-oss text-[#04121d]">
                                  <Check size={10} stroke-width={3} aria-hidden="true" />
                                </span>
                              </td>
                              <td class="py-2 text-muted">{d.jid}</td>
                              <td class="py-2 text-ink">{d.job}</td>
                              <td class="py-2 text-muted">{d.queue}</td>
                              <td class={`py-2 ${d.error === 'decryption_error' ? 'text-warn' : 'text-danger'}`}>{d.error}</td>
                            </tr>
                          ))}
                        </tbody>
                      </table>
                    </div>
                    <div class="mt-4 flex flex-wrap gap-2 font-mono text-[0.7rem]">
                      <span class="text-faint">{cp.labels.redriveCall}</span>
                      <span class="rounded border border-healthy/30 bg-healthy/10 px-1.5 text-healthy">succeeded {cp.bulkResult.succeeded}</span>
                      <span class="rounded border border-line-strong px-1.5 text-muted">missing {cp.bulkResult.missing}</span>
                      <span class="rounded border border-warn/30 bg-warn/10 px-1.5 text-warn">unredrivable {cp.bulkResult.unredrivable}</span>
                      <span class="rounded border border-line-strong px-1.5 text-muted">conflicted {cp.bulkResult.conflicted}</span>
                    </div>
                  </div>
                )}

                {tab.id === 'access' && (
                  <div class="grid gap-5 md:grid-cols-[minmax(0,1.3fr)_minmax(0,1fr)]">
                    <div class="min-w-0 overflow-x-auto">
                      <table class="w-full min-w-[22rem] text-left text-xs">
                        <thead class="font-mono text-faint">
                          <tr>
                            <th class="py-1.5 font-normal">capability</th>
                            <th class="py-1.5 text-center font-normal">viewer</th>
                            <th class="py-1.5 text-center font-normal">operator</th>
                            <th class="py-1.5 text-center font-normal">admin</th>
                          </tr>
                        </thead>
                        <tbody>
                          {cp.roles.map((r) => (
                            <tr class="border-t border-line">
                              <td class="py-2 pr-2 text-muted">{r.capability}</td>
                              {[r.viewer, r.operator, r.admin].map((on) => (
                                <td class="py-2 text-center">
                                  {on ? (
                                    <Check size={14} class="inline text-healthy" aria-label="yes" />
                                  ) : (
                                    <Minus size={14} class="inline text-faint" aria-label="no" />
                                  )}
                                </td>
                              ))}
                            </tr>
                          ))}
                        </tbody>
                      </table>
                    </div>
                    <div class="min-w-0 space-y-3">
                      <div class="space-y-1.5">
                        {cp.security.map((s) => (
                          <div class="flex items-center justify-between gap-2 rounded border border-line bg-bg/50 px-2.5 py-1.5 text-xs">
                            <span class="text-faint">{s.label}</span>
                            <span class="truncate font-mono text-pro">{s.value}</span>
                          </div>
                        ))}
                      </div>
                      <div>
                        <div class="font-mono text-[0.7rem] text-faint">{cp.labels.audit}</div>
                        <ul class="mt-1.5 space-y-1">
                          {cp.audit.map((a) => (
                            <li class="flex items-center justify-between gap-2 rounded border border-line bg-bg/50 px-2 py-1 font-mono text-[0.68rem]">
                              <span class="truncate text-oss">{a.action}</span>
                              <span class="truncate text-muted">{a.actor}</span>
                            </li>
                          ))}
                        </ul>
                      </div>
                    </div>
                  </div>
                )}
              </div>
            </figure>
          </div>
        ))
      }
    </div>
  </div>
</section>

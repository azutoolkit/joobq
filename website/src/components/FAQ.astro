---
import { ChevronRight } from '@lucide/astro';
import { faq, faqHeading } from '../data/faq';
import { inlineCode } from '../lib/text';
---

<section id="faq" class="container-x scroll-mt-20 py-20" aria-labelledby="faq-title">
  <div class="grid gap-10 lg:grid-cols-[minmax(0,18rem)_minmax(0,1fr)]">
    <div>
      <p class="eyebrow">{faqHeading.eyebrow}</p>
      <h2 id="faq-title" class="mt-3 text-3xl font-semibold tracking-tight text-balance">{faqHeading.title}</h2>
    </div>
    <div class="divide-y divide-line border-y border-line">
      {
        faq.map((item, i) => (
          <details class="group py-1" open={i === 0}>
            <summary class="flex cursor-pointer list-none items-center justify-between gap-4 rounded-md py-4 font-medium hover:text-oss [&::-webkit-details-marker]:hidden">
              {item.question}
              <ChevronRight size={18} class="shrink-0 text-faint transition-transform group-open:rotate-90" aria-hidden="true" />
            </summary>
            <div class="copy space-y-3 pb-5 text-sm leading-relaxed text-muted">
              {item.answer.map((paragraph) => (
                <p set:html={inlineCode(paragraph)} />
              ))}
            </div>
          </details>
        ))
      }
    </div>
  </div>
</section>

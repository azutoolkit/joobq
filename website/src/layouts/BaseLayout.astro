---
import '../styles/global.css';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import { site } from '../data/site.config';
import { url } from '../lib/url';

interface Props {
  title?: string;
  description?: string;
  /** True on the landing page: nav anchors then scroll in place. */
  landing?: boolean;
}

const { title, description = site.description, landing = false } = Astro.props;
const pageTitle = title ? `${title} · ${site.name}` : site.title;
const canonical = new URL(Astro.url.pathname, Astro.site).toString();
---

<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <script is:inline>
      // Before first paint: the saved theme, else the system setting, else dark.
      (function () {
        var theme = null;
        try {
          theme = localStorage.getItem('joobq-theme');
        } catch (e) {}
        if (theme !== 'light' && theme !== 'dark') {
          theme = window.matchMedia && window.matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark';
        }
        document.documentElement.setAttribute('data-theme', theme);
      })();
    </script>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href={url('/favicon.svg')} />
    <meta name="theme-color" content="#0f151d" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
  </head>
  <body class="min-h-screen">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:left-3 focus:top-3 focus:z-[60] focus:rounded-md focus:bg-surface focus:px-3 focus:py-2"
      >Skip to content</a
    >
    <Navbar landing={landing} />
    <main id="main">
      <slot />
    </main>
    <Footer />

    <script>
      // Theme toggle ([data-theme-toggle] in the Navbar). Hidden without JavaScript.
      const themeColor = { dark: '#0f151d', light: '#f6f7f9' } as const;
      function applyTheme(theme: 'dark' | 'light') {
        document.documentElement.setAttribute('data-theme', theme);
        document.querySelector('meta[name="theme-color"]')?.setAttribute('content', themeColor[theme]);
        document.querySelectorAll<HTMLElement>('[data-theme-toggle]').forEach((button) => {
          const label = theme === 'dark' ? 'Switch to light theme' : 'Switch to dark theme';
          button.setAttribute('aria-label', label);
          button.title = label;
        });
      }
      applyTheme(document.documentElement.getAttribute('data-theme') === 'light' ? 'light' : 'dark');
      document.querySelectorAll<HTMLElement>('[data-theme-toggle]').forEach((button) => {
        button.hidden = false;
        button.addEventListener('click', () => {
          const next = document.documentElement.getAttribute('data-theme') === 'light' ? 'dark' : 'light';
          applyTheme(next);
          try {
            localStorage.setItem('joobq-theme', next);
          } catch {
            // Storage unavailable (private mode, blocked): the choice lasts for this page only.
          }
        });
      });

      // Accessible tabs for every [data-tabs] group (CodeTabs, ConsolePreview).
      // Markup: [role=tablist] > [role=tab][aria-controls=<panel id>], and [role=tabpanel] panels.
      function select(group: Element, tab: HTMLElement) {
        group.querySelectorAll<HTMLElement>(':scope [role="tab"]').forEach((t) => {
          if (t.closest('[data-tabs]') !== group) return;
          const on = t === tab;
          t.setAttribute('aria-selected', String(on));
          t.tabIndex = on ? 0 : -1;
          const panel = document.getElementById(t.getAttribute('aria-controls') ?? '');
          if (panel) panel.hidden = !on;
        });
      }
      document.querySelectorAll('[data-tabs]').forEach((group) => {
        const tabs = Array.from(group.querySelectorAll<HTMLElement>('[role="tab"]')).filter(
          (t) => t.closest('[data-tabs]') === group,
        );
        tabs.forEach((tab, i) => {
          tab.addEventListener('click', () => select(group, tab));
          tab.addEventListener('keydown', (event) => {
            const keys: Record<string, number> = { ArrowRight: 1, ArrowLeft: -1 };
            let next: HTMLElement | undefined;
            if (event.key in keys) next = tabs[(i + keys[event.key] + tabs.length) % tabs.length];
            if (event.key === 'Home') next = tabs[0];
            if (event.key === 'End') next = tabs[tabs.length - 1];
            if (next) {
              event.preventDefault();
              select(group, next);
              next.focus();
            }
          });
        });
      });
    </script>
  </body>
</html>

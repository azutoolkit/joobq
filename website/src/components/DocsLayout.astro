---
import type { MarkdownHeading } from 'astro';
import { ChevronLeft, ChevronRight, Menu } from '@lucide/astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getSidebar, neighbours } from '../lib/docs';
import { site } from '../data/site.config';
import { editionLabels } from '../data/features';
import { url } from '../lib/url';

interface Props {
  title: string;
  description: string;
  /** Collection id, e.g. "tutorials/first-10-minutes"; empty on the docs index. */
  slug: string;
  product?: 'oss' | 'pro' | 'console';
  headings?: MarkdownHeading[];
}
const { title, description, slug, product, headings = [] } = Astro.props;
const sidebar = await getSidebar();
const { prev, next } = neighbours(sidebar, slug);
const section = sidebar.find((s) => s.dir === slug.split('/')[0]);
const toc = headings.filter((h) => h.depth === 2);
const productTone = { oss: 'text-oss border-oss/30', pro: 'text-pro border-pro/30', console: 'text-healthy border-healthy/30' } as const;
---

<BaseLayout title={title} description={description}>
  <div class="container-x grid gap-8 py-10 lg:grid-cols-[15rem_minmax(0,1fr)] xl:grid-cols-[15rem_minmax(0,1fr)_12rem]">
    <aside class="lg:sticky lg:top-20 lg:max-h-[calc(100vh-6rem)] lg:self-start lg:overflow-y-auto">
      <details id="docs-menu" class="group panel lg:!border-0 lg:!bg-transparent" open>
        <summary class="flex cursor-pointer list-none items-center gap-2 px-4 py-3 text-sm font-medium lg:hidden [&::-webkit-details-marker]:hidden">
          <Menu size={16} aria-hidden="true" /> {site.docsUi.menu}
        </summary>
        <nav aria-label="Documentation" class="space-y-6 px-4 pb-4 lg:px-0">
          <a href={url('/docs')} class:list={['block text-sm', slug === '' ? 'text-oss' : 'text-muted hover:text-ink']}>{site.docsUi.overview}</a>
          {
            sidebar.map((group) => (
              <div>
                <h2 class="font-mono text-[0.7rem] uppercase tracking-wider text-faint">{group.label}</h2>
                <ul class="mt-2 space-y-0.5 border-l border-line">
                  {group.pages.map((page) => {
                    const active = page.slug === slug;
                    return (
                      <li>
                        <a
                          href={url(`/docs/${page.slug}`)}
                          aria-current={active ? 'page' : undefined}
                          class:list={[
                            '-ml-px block border-l py-1 pl-3 text-sm',
                            active ? 'border-oss text-ink' : 'border-transparent text-muted hover:border-line-strong hover:text-ink',
                          ]}
                        >
                          {page.title}
                        </a>
                      </li>
                    );
                  })}
                </ul>
              </div>
            ))
          }
        </nav>
      </details>
      <script is:inline>
        // The sidebar starts open (so it works without JavaScript); fold it on small screens.
        if (window.matchMedia('(max-width: 1023px)').matches) document.getElementById('docs-menu')?.removeAttribute('open');
      </script>
    </aside>

    <article class="min-w-0">
      <header class="border-b border-line pb-6">
        <div class="flex flex-wrap items-center gap-2 font-mono text-xs text-faint">
          {section && <span>{section.label}</span>}
          {
            product && (
              <span class={`rounded-full border px-2 py-0.5 ${productTone[product]}`}>{editionLabels[product]}</span>
            )
          }
        </div>
        <h1 class="mt-3 text-3xl font-bold tracking-tight text-balance sm:text-4xl">{title}</h1>
        <p class="mt-3 text-lg text-muted">{description}</p>
      </header>
      <div class="prose-docs mt-8">
        <slot />
      </div>

      {
        slug && (
          <footer class="mt-14 border-t border-line pt-6">
            <nav class="grid gap-3 sm:grid-cols-2" aria-label="Previous and next page">
              {prev ? (
                <a href={url(`/docs/${prev.slug}`)} class="panel block p-4 hover:border-line-strong">
                  <span class="flex items-center gap-1 font-mono text-xs text-faint">
                    <ChevronLeft size={14} aria-hidden="true" /> {site.docsUi.previous}
                  </span>
                  <span class="mt-1 block text-sm font-medium">{prev.title}</span>
                </a>
              ) : (
                <span />
              )}
              {next && (
                <a href={url(`/docs/${next.slug}`)} class="panel block p-4 text-right hover:border-line-strong">
                  <span class="flex items-center justify-end gap-1 font-mono text-xs text-faint">
                    {site.docsUi.next} <ChevronRight size={14} aria-hidden="true" />
                  </span>
                  <span class="mt-1 block text-sm font-medium">{next.title}</span>
                </a>
              )}
            </nav>
            <p class="mt-6 text-xs text-faint">
              <a class="hover:text-ink hover:underline" href={`${site.docsSourceUrl}/${slug}.md`}>{site.docsUi.edit}</a>
            </p>
          </footer>
        )
      }
    </article>

    {
      toc.length > 1 && (
        <aside class="hidden xl:block">
          <nav aria-label="On this page" class="sticky top-20">
            <h2 class="font-mono text-[0.7rem] uppercase tracking-wider text-faint">{site.docsUi.onThisPage}</h2>
            <ul class="mt-3 space-y-1.5 text-sm">
              {toc.map((h) => (
                <li>
                  <a href={`#${h.slug}`} class="text-muted hover:text-ink">
                    {h.text}
                  </a>
                </li>
              ))}
            </ul>
          </nav>
        </aside>
      )
    }
  </div>
</BaseLayout>

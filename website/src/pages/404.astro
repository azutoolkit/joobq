---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../data/site.config';
import { url } from '../lib/url';
---

<BaseLayout title={site.notFound.title}>
  <section class="container-x py-32 text-center">
    <p class="eyebrow justify-center">404</p>
    <h1 class="mt-3 text-3xl font-semibold">{site.notFound.title}</h1>
    <p class="mt-3 text-muted">{site.notFound.body}</p>
    <div class="mt-8 flex justify-center gap-3">
      <a class="btn btn-primary" href={url('/')}>{site.notFound.home}</a>
      <a class="btn btn-secondary" href={url('/docs')}>{site.notFound.docs}</a>
    </div>
  </section>
</BaseLayout>

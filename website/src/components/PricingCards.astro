---
import { Check } from '@lucide/astro';
import { pricing, pricingHeading, pricingNote } from '../data/pricing';
import { site } from '../data/site.config';
import { url } from '../lib/url';
import { withPeriod } from '../lib/text';

// A CTA href of "contact" means the site's contact address.
const ctaHref = (href: string) => (href === 'contact' ? site.contactUrl : url(href));
const title = withPeriod(pricingHeading.title);
---

<section id="pricing" class="scroll-mt-20 border-y border-line bg-surface-2 py-20" aria-labelledby="pricing-title">
  <div class="container-x">
    <p class="eyebrow">{pricingHeading.eyebrow}</p>
    <h2 id="pricing-title" class="mt-3 max-w-3xl text-3xl font-semibold tracking-tight text-balance">
      {title.text}<span class="text-accent">{title.period}</span>
    </h2>
    <p class="mt-4 max-w-2xl text-sm text-muted">{pricingNote}</p>

    <ul class="mt-10 grid gap-4 md:grid-cols-2 xl:grid-cols-4">
      {
        pricing.map((tier) => (
          <li
            class:list={[
              'panel relative flex flex-col p-6',
              tier.highlighted && '!border-accent',
            ]}
          >
            <div class="flex items-center justify-between gap-2">
              <h3 class="font-semibold">{tier.name}</h3>
              <span class="flex flex-wrap justify-end gap-1.5">
                {tier.highlighted && <span class="pill pill-accent pill-dot">{pricingHeading.popularBadge}</span>}
                {tier.placeholder && <span class="pill pill-warn">{pricingHeading.placeholderBadge}</span>}
              </span>
            </div>
            <p class="mt-4 flex items-baseline gap-1">
              <span class="font-mono text-3xl font-semibold tracking-tight">{tier.price}</span>
              {tier.period && <span class="text-sm text-faint">{tier.period}</span>}
            </p>
            <p class="mt-2 text-sm text-muted">{tier.blurb}</p>
            <ul class="mt-6 flex-1 space-y-2.5 text-sm">
              {tier.features.map((feature) => (
                <li class="flex gap-2.5">
                  <Check size={16} class="mt-0.5 shrink-0 text-accent" aria-hidden="true" />
                  <span class="text-muted">{feature}</span>
                </li>
              ))}
            </ul>
            <a
              href={ctaHref(tier.cta.href)}
              class:list={['btn mt-8 justify-center', tier.highlighted ? 'btn-primary' : 'btn-secondary']}
            >
              {tier.cta.label}
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</section>

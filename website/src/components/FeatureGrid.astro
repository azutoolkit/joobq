---
import {
  Layers,
  Workflow,
  Monitor,
  Repeat,
  Clock,
  Lock,
  Gauge,
  GitBranch,
  RotateCcwClock,
  Shield,
  Bell,
  Activity,
  Users,
  Archive,
  Search,
  Server,
} from '@lucide/astro';
import type { FeatureSection, IconName } from '../data/features';
import { editionLabels } from '../data/features';
import { inlineCode, withPeriod } from '../lib/text';

interface Props {
  section: FeatureSection;
}
const { section } = Astro.props;

const ICONS: Record<IconName, typeof Layers> = {
  layers: Layers,
  workflow: Workflow,
  monitor: Monitor,
  repeat: Repeat,
  clock: Clock,
  lock: Lock,
  gauge: Gauge,
  'git-branch': GitBranch,
  history: RotateCcwClock,
  shield: Shield,
  bell: Bell,
  activity: Activity,
  users: Users,
  archive: Archive,
  search: Search,
  server: Server,
};
// Icons stay muted; the edition shows as a small label, violet-dotted for Pro.
const editionDot = { oss: 'bg-accent', pro: 'bg-pro', console: 'bg-faint' } as const;
const title = withPeriod(section.title);
---

<section id={section.id} class="container-x scroll-mt-20 py-20" aria-labelledby={`${section.id}-title`}>
  <p class="eyebrow">{section.eyebrow}</p>
  <h2 id={`${section.id}-title`} class="mt-3 max-w-3xl text-3xl font-semibold tracking-tight text-balance">
    {title.text}<span class="text-accent">{title.period}</span>
  </h2>
  <p class="mt-4 max-w-2xl text-muted">{section.intro}</p>
  <ul class="mt-10 grid gap-px overflow-hidden rounded-[0.65rem] border border-line bg-line sm:grid-cols-2 lg:grid-cols-3">
    {
      section.features.map((feature) => {
        const Icon = ICONS[feature.icon];
        return (
          <li class="flex flex-col bg-surface p-6">
            <div class="flex items-center justify-between gap-3">
              <span class="icon-tile">
                <Icon size={18} aria-hidden="true" />
              </span>
              <span class="label inline-flex items-center gap-1.5">
                <span class={`size-1.5 rounded-full ${editionDot[feature.edition]}`} aria-hidden="true" />
                {editionLabels[feature.edition]}
              </span>
            </div>
            <h3 class="mt-4 font-semibold">{feature.title}</h3>
            <p class="copy mt-2 text-sm leading-relaxed text-muted" set:html={inlineCode(feature.body)} />
          </li>
        );
      })
    }
  </ul>
</section>

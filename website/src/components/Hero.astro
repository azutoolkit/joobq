---
import { ArrowRight, ShieldCheck } from '@lucide/astro';
import CodeTabs from './CodeTabs.astro';
import { site } from '../data/site.config';
import { heroExamples } from '../data/code-examples';
import { url } from '../lib/url';
import { withPeriod } from '../lib/text';

const { hero, versions, trust } = site;
const headline = withPeriod(hero.headline);
---

<section class="relative isolate overflow-hidden border-b border-line">
  <div
    class="grid-bg absolute inset-0 -z-10 [mask-image:linear-gradient(to_bottom,black,transparent_85%)]"
    aria-hidden="true"
  >
  </div>
  <div class="container-x grid items-center gap-12 py-16 lg:grid-cols-[1fr_1.1fr] lg:py-24">
    <div class="min-w-0">
      <p class="eyebrow">{hero.eyebrow}</p>
      <h1 class="mt-5 text-4xl font-semibold leading-[1.08] tracking-tight text-balance sm:text-5xl lg:text-[3.25rem]">
        {headline.text}<span class="text-accent">{headline.period}</span>
      </h1>
      <p class="mt-6 max-w-xl text-lg leading-relaxed text-muted text-pretty">{hero.subheadline}</p>
      <div class="mt-8 flex flex-wrap gap-3">
        <a href={url(hero.primary.href)} class="btn btn-primary">
          {hero.primary.label}
          <ArrowRight size={16} aria-hidden="true" />
        </a>
        <a href={url(hero.secondary.href)} class="btn btn-secondary">{hero.secondary.label}</a>
      </div>
      <ul class="mt-10 grid gap-x-6 gap-y-3 border-t border-line pt-6 sm:grid-cols-2" aria-label="What you get">
        {
          trust.map((cue) => (
            <li class="flex min-w-0 gap-2.5">
              <ShieldCheck size={16} class="mt-0.5 shrink-0 text-accent" aria-hidden="true" />
              <span class="min-w-0 text-sm">
                <span class="font-medium text-ink">{cue.label}</span>
                <span class="block text-[0.8125rem] text-muted">{cue.detail}</span>
              </span>
            </li>
          ))
        }
      </ul>
      <dl class="mt-6 flex flex-wrap gap-x-6 gap-y-2 font-mono text-xs text-faint">
        <div><dt class="inline">crystal</dt> <dd class="inline text-ink">&gt;= {versions.crystal}</dd></div>
        <div><dt class="inline">joobq</dt> <dd class="inline text-ink">{versions.core}</dd></div>
        <div>
          <dt class="inline">joobq_pro</dt>
          <dd class="inline text-ink"><span class="mr-1 inline-block size-1.5 rounded-full bg-pro align-middle" aria-hidden="true"></span>{versions.pro}</dd>
        </div>
      </dl>
    </div>
    <div class="min-w-0">
      <CodeTabs examples={heroExamples} id="hero" />
    </div>
  </div>
</section>

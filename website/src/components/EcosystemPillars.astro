---
import { Check, ChevronRight } from '@lucide/astro';
import { pillars, pillarsHeading } from '../data/features';
import { url } from '../lib/url';
import { inlineCode as md, withPeriod } from '../lib/text';

// One accent: only the Pro pill is violet.
const tagPill = { oss: 'pill-accent', pro: 'pill-pro', console: 'pill-neutral' } as const;
const title = withPeriod(pillarsHeading.title);
---

<section class="container-x py-20" aria-labelledby="ecosystem-title">
  <p class="eyebrow">{pillarsHeading.eyebrow}</p>
  <h2 id="ecosystem-title" class="mt-3 max-w-2xl text-3xl font-semibold tracking-tight text-balance">
    {title.text}<span class="text-accent">{title.period}</span>
  </h2>
  <ol class="mt-10 grid gap-4 lg:grid-cols-3">
    {
      pillars.map((pillar, i) => (
        <li class="panel flex flex-col p-6">
          <div class="flex items-center justify-between gap-3">
            <span class="font-mono text-xs text-faint">0{i + 1}</span>
            <span class={`pill pill-dot ${tagPill[pillar.edition]}`}>{pillar.tag}</span>
          </div>
          <h3 class="mt-4 text-xl font-semibold">{pillar.name}</h3>
          <p class="mt-2 text-sm text-muted">{pillar.summary}</p>
          <ul class="copy mt-5 space-y-2.5 text-sm">
            {pillar.points.map((point) => (
              <li class="flex gap-2.5">
                <Check size={16} class="mt-0.5 shrink-0 text-accent" aria-hidden="true" />
                <span class="text-muted" set:html={md(point)} />
              </li>
            ))}
          </ul>
          <a href={url(pillar.cta.href)} class="mt-auto inline-flex items-center gap-1 pt-6 text-sm font-medium text-accent hover:underline">
            {pillar.cta.label}
            <ChevronRight size={16} aria-hidden="true" />
          </a>
        </li>
      ))
    }
  </ol>
</section>

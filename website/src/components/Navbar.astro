---
import { Menu, ArrowRight, Sun, Moon } from '@lucide/astro';
import { site } from '../data/site.config';
import { url, navHref } from '../lib/url';

interface Props {
  landing?: boolean;
}
const { landing = false } = Astro.props;
const { announcement, nav, navCta } = site;
// GitHub mark (lucide ships no brand icons).
const githubPath =
  'M12 .5a11.5 11.5 0 0 0-3.64 22.41c.58.1.79-.25.79-.56v-2c-3.2.7-3.88-1.37-3.88-1.37-.53-1.33-1.28-1.69-1.28-1.69-1.05-.71.08-.7.08-.7 1.16.08 1.77 1.19 1.77 1.19 1.03 1.77 2.7 1.26 3.36.96.1-.75.4-1.26.73-1.55-2.55-.29-5.24-1.28-5.24-5.68 0-1.25.45-2.28 1.19-3.08-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.17 1.18a11 11 0 0 1 5.77 0c2.2-1.49 3.17-1.18 3.17-1.18.63 1.59.23 2.76.11 3.05.74.8 1.19 1.83 1.19 3.08 0 4.41-2.69 5.39-5.25 5.67.41.36.78 1.06.78 2.14v3.17c0 .31.21.67.8.56A11.5 11.5 0 0 0 12 .5Z';
---

{
  announcement.enabled && (
    <div class="border-b border-line bg-surface-2 text-[0.8125rem]">
      <div class="container-x flex flex-wrap items-center justify-center gap-x-3 gap-y-1 py-2 text-center">
        <span class="pill pill-pro pill-dot font-semibold uppercase tracking-wider !text-[0.625rem]">New</span>
        <span class="text-muted">{announcement.text}</span>
        {announcement.href && (
          <a href={url(announcement.href)} class="inline-flex items-center gap-1 font-medium text-ink underline decoration-line-strong underline-offset-4 hover:decoration-accent">
            {announcement.linkLabel ?? 'Read more'}
            <ArrowRight size={14} aria-hidden="true" />
          </a>
        )}
      </div>
    </div>
  )
}

<header class="sticky top-0 z-50 border-b border-line bg-surface/80 backdrop-blur-lg">
  <nav class="container-x flex h-16 items-center gap-6" aria-label="Main">
    <a href={url('/')} class="flex shrink-0 items-center gap-2 font-semibold tracking-tight">
      <img src={url('/favicon.svg')} alt="" width="28" height="28" />
      <span class="text-[1.05rem]">{site.name}</span>
    </a>

    <ul class="hidden items-center gap-1 text-sm text-muted lg:flex">
      {
        nav.map((link) => (
          <li>
            <a href={navHref(link.href, landing)} class="rounded-md px-2.5 py-1.5 hover:bg-hover hover:text-ink">
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>

    <div class="ml-auto flex items-center gap-2">
      <a
        href={site.repoUrl}
        class="hidden items-center gap-1.5 rounded-md px-2.5 py-1.5 text-sm text-muted hover:bg-hover hover:text-ink sm:inline-flex"
      >
        <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor" aria-hidden="true"><path d={githubPath} /></svg>
        GitHub
      </a>
      <button type="button" class="icon-btn" data-theme-toggle hidden aria-label="Switch theme">
        <Sun size={16} class="theme-icon-dark" aria-hidden="true" />
        <Moon size={16} class="theme-icon-light" aria-hidden="true" />
      </button>
      <a href={url(navCta.href)} class="btn btn-primary hidden !py-1.5 sm:inline-flex">{navCta.label}</a>

      <details class="group relative lg:hidden">
        <summary
          class="icon-btn cursor-pointer list-none [&::-webkit-details-marker]:hidden"
          aria-label="Open menu"
        >
          <Menu size={18} aria-hidden="true" />
        </summary>
        <div class="panel absolute right-0 top-12 w-64 p-2">
          <ul class="flex flex-col text-sm">
            {
              nav.map((link) => (
                <li>
                  <a href={navHref(link.href, landing)} class="block rounded-md px-3 py-2 text-muted hover:bg-hover hover:text-ink">
                    {link.label}
                  </a>
                </li>
              ))
            }
            <li>
              <a href={site.repoUrl} class="flex items-center gap-2 rounded-md px-3 py-2 text-muted hover:bg-hover hover:text-ink">
                <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor" aria-hidden="true"><path d={githubPath} /></svg> GitHub
              </a>
            </li>
            <li class="mt-1 border-t border-line pt-2">
              <a href={url(navCta.href)} class="btn btn-primary w-full justify-center">{navCta.label}</a>
            </li>
          </ul>
        </div>
      </details>
    </div>
  </nav>
</header>
